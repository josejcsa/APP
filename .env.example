# GoDaddy Node.js Hosting Environment Configuration

# Server Configuration
# PORT: Auto-assigned by GoDaddy Node.js Hosting (default 3000)
# Always use process.env.PORT, never hardcode
PORT=3000
NODE_ENV=production

# Application URLs
APP_URL="https://your-app.godaddy.com"

# Gemini AI API Key (for solar assessment features)
GEMINI_API_KEY="your_gemini_api_key_here"

# GoDaddy Managed MySQL Database
# These credentials are auto-injected by GoDaddy Node.js Hosting when MySQL is enabled
# Read from process.env - do NOT hardcode or commit real credentials
DB_HOST=mysql.your-godaddy-host.com
DB_PORT=3306
DB_NAME=elthera_db
DB_USER=elthera_user
DB_PASSWORD=your_secure_password_here

# Application Settings
APP_NAME=elthera-pro
VERSION=1.0.0

# Logging
LOG_LEVEL=info
